SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=mysql+pymysql://root:root@localhost/queuecloud
SESSION_COOKIE_SECURE=0

# AWS RDS example:
# DATABASE_URL=mysql+pymysql://queuecloud_user:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:3306/queuecloud
# SESSION_COOKIE_SECURE=1

# ─── AWS Credentials (IAM user with ses:SendEmail + s3:PutObject) ───
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ─── AWS SES – Email Notifications (Free Tier: 200 emails/day in sandbox) ───
# SES_SENDER_EMAIL=noreply@yourdomain.com
#   → Must be a VERIFIED address/domain in AWS SES console

# ─── AWS S3 – Static Asset Hosting (Free Tier: 5 GB, 20k GET, 2k PUT/mo) ───
# S3_BUCKET_NAME=queuecloud-static
# S3_BUCKET_URL=https://queuecloud-static.s3.amazonaws.com
#   → Run: python manage_s3.py  to upload static files to S3
